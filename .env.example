# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL / Cloud SQL Database Configuration (Mandatory in Production / Cloud Run)
# Attach via Secret Manager secret DATABASE_URL or Cloud SQL connection parameters
DATABASE_URL=
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
CLOUD_SQL_CONNECTION_NAME=
# Strict TLS verification CA certificate (optional)
CA_CERT=
# Local development standalone storage (ONLY valid in local development, never on Cloud Run)
ALLOW_LOCAL_STORAGE=false

# Gemini AI Key (Server Side Only)
GEMINI_API_KEY=

# Stripe Payments Key (Server Side Only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional MapLibre Style URL Override (defaults to OpenFreeMap dark style)
# OpenFreeMap allows free production usage with OSM attribution.
# For private enterprise deployments, set your own vector style JSON endpoint here:
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# WebRTC TURN Relay Configuration (RFC 5766 ephemeral credentials HMAC-SHA1)
# Production deployment requires TURN for strict NAT/firewall traversal across mobile carriers.
TURN_URLS=
TURN_SECRET=

# Snapchat Camera Kit AR Integration (Server/Client API Token & Lens Group)
# Acquired via Snap Kit Developer Portal (https://developers.snap.com/)
SNAP_CAMERA_KIT_API_TOKEN=
SNAP_CAMERA_KIT_LENS_GROUP_ID=

# Existing recurring Stripe Price IDs from the SAME account as the restricted key
STRIPE_PRICE_THREE_MONTH=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Canonical public HTTPS origin; never derived from request headers
APP_BASE_URL=
